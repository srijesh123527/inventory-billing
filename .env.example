# ============================================================================
# InvFlow — Environment Configuration Template
# ============================================================================

# Environment: 'development' or 'production'
NODE_ENV=development

# Server Port (Default: 3000)
PORT=3000

# JWT Authentication Secret Key
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# Production Database (PostgreSQL)
# Provide your PostgreSQL connection URL (e.g. from Neon, Supabase, Render, AWS RDS)
# Format: postgresql://username:password@hostname:port/database?sslmode=require
# If left blank or unset, local development will automatically use local SQLite (backend/database.db)
DATABASE_URL=
