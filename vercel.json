{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(index|login|products|suppliers|stock|billing|reports).html",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "/(index|login|products|suppliers|stock|billing|reports)",
      "dest": "/frontend/$1.html"
    }
  ]
}
